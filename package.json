{
  "name": "dsh-quick-reply",
  "version": "0.2.1",
  "description": "Adds a composer-dock button that sends a user-configured, ordered sequence of messages (e.g. \"按照你的推荐建议执行\", \"继续\") into the current DSH session.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micln/dsh-quick-reply.git"
  },
  "homepage": "https://github.com/micln/dsh-quick-reply",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "quick-reply"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
